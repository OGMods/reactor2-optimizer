{
  "name": "reactor2-optimizer",
  "version": "1.0.0",
  "description": "A layout planner and solver for Reactor 2: Nuclear Tycoon - paint a board, declare your unlocks, and get a near-optimal reactor/generator/cooler placement.",
  "license": "GPL-3.0-or-later",
  "author": "OGMods",
  "homepage": "https://ogmods.github.io/reactor2-optimizer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OGMods/reactor2-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/OGMods/reactor2-optimizer/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "lucide-svelte": "^1.0.1",
    "pixi.js": "^8.19.0"
  }
}
